# Copy this file to .env and fill in only the providers you use.
# .env is git-ignored and is passed to the container at run time.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
S2_API_KEY=

# Required only when using Claude through AWS Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION_NAME=
